  m_Script: {fileID: 11500000, guid: af53a40d0647b1f48a2b87317e2f549a, type: 3}
  m_Name: Qts
  m_EditorClassIdentifier: 
  questions:
  - questionText: Which part of the computer is responsible for executing instructions
      and performing calculations?
    replies:
    - Hard Drive
    - CPU (Central Processing Unit)
    - RAM (Random Access Memory)
    - GPU (Graphics Processing Unit)
    correctReplyIndex: 1
  - questionText: What does RAM stand for ??
    replies:
    - Read Access Memory
    - Random Access Memory
    - Rapid Access Memory
    - Real-time Access Memory
    correctReplyIndex: 1
  - questionText: Which of the following is a non-volatile storage device?
    replies:
    - RAM
    - Hard Disk Drive (HDD)
    - CPU
    - Graphics Card
    correctReplyIndex: 1
  - questionText: What is the primary function of the motherboard in a computer?
    replies:
    - To provide power to the system
    - To store data
    - To connect and allow communication between all components
    - To display visual output on the screen
    correctReplyIndex: 2
  - questionText: Which component is most responsible for rendering images and video
      in a computer?
    replies:
    - CPU
    - RAM
    - GPU
    - Power Supply
    correctReplyIndex: 2
  - questionText: Which of these is the fastest type of storage?
    replies:
    - HDD
    - SSD
    - Optical Disk
    - Flash Drive
    correctReplyIndex: 2
  - questionText: What does PSU stand for in computer hardware?
    replies:
    - Power Supply Unit
    - Processor Support Unit
    - To connect and allow communication between all components
    - Personal Storage Unit
    correctReplyIndex: 0
  - questionText: Which part of the computer is responsible for cooling the internal
      components?
    replies:
    - Power Supply
    - CPU Cooler
    - RAM
    - Hard Drive
    correctReplyIndex: 1
  - questionText: What is the purpose of the BIOS in a computer?
    replies:
    - To manage the power supply
    - To store the operating system
    - To perform hardware initialization during boot-up
    - To control the graphics output
    correctReplyIndex: 2
  - questionText: Which of these is an input device?
    replies:
    - Printer
    - Monitor
    - Mouse
    - Speaker
    correctReplyIndex: 2
  - questionText: What is the function of a heat sink in a computer?
    replies:
    - ' To store data'
    - To cool down the CPU or GPU
    - ' To provide power to the motherboard'
    - To display the system information
    correctReplyIndex: 1
  - questionText: Which of the following best describes the function of a hard drive?
    replies:
    - It executes software programs
    - It stores operating system files
    - It processes instructions
    - 'It displays visual output '
    correctReplyIndex: 1
  - questionText: What is the primary purpose of the video card (GPU) in a computer?
    replies:
    - To store the operating system
    - To process graphical data and output to the screen
    - To provide cooling to the CPU
    - ' To manage network connections'
    correctReplyIndex: 1
  - questionText: Which port is commonly used to connect external devices such as
      a keyboard, mouse, or printer?
    replies:
    - HDMI
    - USB
    - VGA
    - Ethernet
    correctReplyIndex: 1
  - questionText: Which of these is the most common type of RAM used in modern desktops?
    replies:
    - DDR3
    - DDR4
    - DDR5
    - SD-RAM
    correctReplyIndex: 1
